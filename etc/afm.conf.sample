# alternative-fabric-manager configuration. networking-mlnx's ml2_conf.ini
# then has:
#
#   [sdn]
#   url = http://<host>:<port><url_prefix>, e.g. http://127.0.0.1:8090/ufmRestV3
#   domain = <domain>
#   token = <token>

[api]
host = 127.0.0.1
port = 8090
url_prefix = /ufmRestV3
domain = cloudx
# Requests must carry "Authorization: Basic <token>". Required.
token =

[database]
database = /var/lib/alternative-fabric-manager/afm.sqlite

[opensm]
# managed: the manager runs OpenSM in its own container, in the manager's
#   PID namespace, so that OpenSM never outlives the manager. The manager
#   writes opensm.conf and partitions.conf, and starts OpenSM again if it
#   stops.
# docker: OpenSM runs in a container that something else starts, reading
#   partitions.conf from config_dir; the manager only sends it SIGHUP.
# none: only write the files.
driver = managed
container = opensm
image = ghcr.io/stackhpc/docker-opensm:latest
# Extra OpenSM arguments; prefer [opensm_conf].
opensm_args =
# Mounts of the OpenSM container, besides config_dir, as
# source:destination[:mode], separated by commas.
volumes = /lib/modules:/lib/modules:ro,/etc/localtime:/etc/localtime:ro,opensm_logs:/var/log,opensm_cache:/var/cache/opensm
# The manager's own container, whose PID namespace OpenSM joins.
manager_container = alternative-fabric-manager
# OpenSM's files, as the manager sees them, and as the host does (for
# OpenSM's bind mount). OpenSM sees them at /etc/opensm.
config_dir = /etc/opensm
host_config_dir = /etc/opensm
# A Jinja template for partitions.conf, instead of the default. It gets
# default_partition, networks (each with id, name, pkey, pkey_hex and guids),
# ipoib (rate, mtu, sl) and generation, and what it renders is checked: every
# network's pkey must have exactly its ports as full members.
partitions_template =
# Write the hardened OpenSM options of docs/opensm-hardening.md into
# opensm.conf: M_Key protection, secret SM and SA keys kept in the database,
# the SA enhanced trust model, and more. Override any of them in
# [opensm_conf].
hardening = true
start_timeout = 120
sweep_timeout = 30
check_interval = 5
apply_attempts = 3
# Written as is. By default every port is only a limited member, so ports
# can't reach each other in the default partition; flat networks' ports are
# added as full members. See docs/opensm-hardening.md. On a fabric that
# already runs, match the rate and MTU of the existing broadcast group
# (saquery -g), or OpenSM recreates it, which disrupts IPoIB on the default
# partition, for example:
#   Default=0x7fff, ipoib, rate=2, mtu=4, sl=0 : ALL=limited, SELF=full ;
default_partition = Default=0x7fff, ipoib : ALL=limited, SELF=full ;
# IPoIB broadcast group of networks' partitions, as IBTA values.
ipoib_rate = 3
ipoib_mtu = 4
ipoib_sl = 0

[opensm_conf]
# opensm.conf options for the managed driver, as "key = value". These win
# over the hardened options. OpenSM uses its defaults for the others.
# partition_config_file and daemon are set by the manager.
#sm_priority = 15
#log_flags = 0x07
