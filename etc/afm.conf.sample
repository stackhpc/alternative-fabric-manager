# alternative-fabric-manager configuration. networking-mlnx's ml2_conf.ini
# then has:
#
#   [sdn]
#   url = http://<host>:<port><url_prefix>, e.g. http://127.0.0.1:8090/ufmRestV3
#   domain = <domain>
#   token = <token>

[api]
host = 127.0.0.1
port = 8090
url_prefix = /ufmRestV3
domain = cloudx
# Requests must carry "Authorization: Basic <token>". Required.
token =

[database]
# An SQLite file, for a single instance
database = /var/lib/alternative-fabric-manager/afm.sqlite
# Or a database URL, for MariaDB or Galera, which HA needs; it overrides
# database. Run alternative-fabric-manager --db-upgrade after each upgrade.
#connection = mysql+pymysql://afm:<password>@<vip>/afm

[opensm]
# managed: the manager runs OpenSM in its own container, in the manager's
#   PID namespace, so that OpenSM never outlives the manager. The manager
#   writes opensm.conf and partitions.conf, and starts OpenSM again if it
#   stops.
# docker: OpenSM runs in a container that something else starts, reading
#   partitions.conf from config_dir; the manager only sends it SIGHUP.
# none: only write the files.
driver = managed
container = opensm
image = ghcr.io/stackhpc/docker-opensm:latest
# Mounts of the OpenSM container, besides config_dir, as
# source:destination[:mode], separated by commas.
volumes = /lib/modules:/lib/modules:ro,/etc/localtime:/etc/localtime:ro,opensm_logs:/var/log,opensm_cache:/var/cache/opensm
# The manager's own container, whose PID namespace OpenSM joins.
manager_container = alternative-fabric-manager
# OpenSM's files, as the manager sees them, and as the host does (for
# OpenSM's bind mount). OpenSM sees them at /etc/opensm.
config_dir = /etc/opensm
host_config_dir = /etc/opensm
# A Jinja template for partitions.conf, instead of the default. It gets
# default_partition, networks (each with id, name, pkey, pkey_hex and guids),
# flat (the flat networks' partition, with the same keys), ipoib (rate, mtu,
# sl) and generation. What it renders is checked: every network's partition
# must have exactly its ports as full members, a port may be in only one,
# and ALL, ALL_CAS and ALL_VCAS can't be full members elsewhere.
partitions_template =
# The groups of hardened OpenSM options, from docs/opensm-hardening.md, to
# write into opensm.conf, separated by commas: m_key, sm_key, sa_key,
# sa_trust, enforcement, babbling_ports; all; -group to remove one from all;
# or none. all, the default, hardens everything; "-sa_trust" hardens
# everything but sa_trust; "m_key, enforcement" hardens only those. A new
# group joins all once tested, and an upgrade then turns it on: read the
# release notes, and remove it with -group if needed. The experimental
# groups, untested on hardware, aren't in all, and are named beside it: read
# their Before enabling checklists in docs/opensm-hardening.md first.
# m_key_per_port, per-port M_Keys, experimental, untested on hardware:
# "all, m_key_per_port" permits them.
# allowed_sm, experimental, untested on hardware: "all, allowed_sm" makes
# OpenSM ignore every subnet manager outside this host's physical ports.
# class_keys, experimental, untested on hardware: "all, class_keys" keys
# every port's VS, CC and N2N classes from the stored seed; it leaves keys on
# ports, so turn it off by disabling first (docs/opensm-hardening.md).
# sa_rate, experimental, untested on hardware: "all, sa_rate" limits each
# port to 1000 SA requests per 100 ms (sa_rate_threshold).
# [opensm_conf] overrides any single option.
hardening = all
# The lease, in seconds, of every key the manager sets on ports: the M_Key,
# and the class keys once a group sets them, up to 65535. A port drops its
# protection once no subnet manager has reached it for that long after a
# wrong-keyed packet, so a port whose key is lost, for example with the
# database, is expected to be keyed again by waiting. Any tenant can then
# read the port's M_Key, which without m_key_per_port is shared by every
# port and can't be rotated yet: an outage of every subnet manager (in HA
# mode, of the database too) longer than the lease compromises the fabric
# for good. 3600, the default, is far
# longer than any restart or takeover; 60 suits only a test fabric. 0 makes
# the keys permanent: a port never drops its protection, and a port whose
# key is lost stays locked until it's reset. The same on every node in HA
# mode. See docs/opensm-hardening.md, Permanent keys.
key_lease_period = 3600
start_timeout = 120
sweep_timeout = 30
check_interval = 5
# With the m_key_per_port group, seconds between full verifies of every
# recorded port's M_Key; the fabric check fails if the last one is older
# than two of these.
port_verify_interval = 60
apply_attempts = 3
# Written as is. By default every port is only a limited member, so ports
# can't reach each other in the default partition; flat networks' ports are
# added as full members. See docs/opensm-hardening.md. On a fabric that
# already runs, match the rate and MTU of the existing broadcast group
# (saquery -g), or OpenSM recreates it, which disrupts IPoIB on the default
# partition, for example:
#   Default=0x7fff, ipoib, rate=2, mtu=4, sl=0 : ALL=limited, SELF=full ;
default_partition = Default=0x7fff, ipoib : ALL=limited, SELF=full ;
# The partition of flat networks, outside the VLAN range. 0x7fff makes their
# ports full members of the default partition instead, which every tenant can
# reach.
flat_pkey = 0x7ffe
# Allow ALL=full in the default partition, which lets every port, other
# tenants' included, reach every other there. Only for a fabric that relies
# on it.
shared_default_partition = false
# IPoIB broadcast group of networks' partitions, as IBTA values.
ipoib_rate = 3
ipoib_mtu = 4
ipoib_sl = 0

[opensm_conf]
# opensm.conf options for the managed driver, as "key = value". These win
# over the hardened options. OpenSM uses its defaults for the others.
# partition_config_file and daemon are set by the manager. The experimental
# groups' options can be overridden here too: see docs/opensm-hardening.md,
# Experimental hardening.
# allowed_sm_guids replaces the allowed_sm group's list, with its checks.
#sm_priority = 15
#log_flags = 0x07
